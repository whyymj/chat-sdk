# AI Agent 配置(复制本文件为 .env 并填入真实值;.env 已被 gitignore,不会入库)
VITE_AI_API_KEY=sk-your-api-key-here
VITE_AI_BASE_URL=https://api.deepseek.com
VITE_AI_MODEL=deepseek-chat
# JSON / 结构化操作建议低温(0.2-0.3),提高格式与数值准确率
VITE_AI_TEMPERATURE=0.3
# 输出上限:操作大 JSON 需要较大输出窗口 
VITE_AI_MAX_TOKENS=16384
# 系统提示词(必须单行;.env 不支持多行值);通用页面操作助手身份
VITE_AI_SYSTEM_PROMPT=你是通用页面操作助手。通过工具读写宿主页面的 window 属性(仅限属性注册表内、经 schema 校验),并支持 GET 抓取文档。回答用中文,先结论后展开,不确定的明确说明。

# 调试模式:开发期 true(查看请求上下文/工具调用),生产环境 false
VITE_DEBUG=false

# 上下文压缩策略配置(跨轮历史压缩,详见 useContextManager)
# 滑动窗口:保留最近几轮完整对话(默认 6)
VITE_CONTEXT_WINDOW_ROUNDS=6
# 超过多少轮触发摘要压缩(默认 8)
VITE_CONTEXT_SUMMARY_THRESHOLD=8
# 单轮 ReAct 内旧工具结果截断长度(仅旧链路 useChat;新 harness 大结果已自动外存 vfs)
VITE_CONTEXT_TOOL_RESULT_MAX=800
# 是否启用关键词召回相关历史(默认 true,设为 false 关闭)
VITE_CONTEXT_ENABLE_RECALL=true
# 召回的最大轮次数(默认 3)
VITE_CONTEXT_RECALL_TOPK=3
# 是否启用 LLM 增强摘要(默认 false 用零成本索引摘要,设为 true 用 LLM 生成段落摘要)
VITE_CONTEXT_LLM_SUMMARY=false

# 记忆压缩专用 LLM 配置(仅在 VITE_CONTEXT_LLM_SUMMARY=true 时生效)
# 独立配置,便于用更便宜/更快的模型做摘要;各项缺省时回退到主 Agent 配置(VITE_AI_*)
VITE_CONTEXT_LLM_MODEL=deepseek-chat
# VITE_CONTEXT_LLM_API_KEY=sk-xxx   # 缺省回退到 VITE_AI_API_KEY
# VITE_CONTEXT_LLM_BASE_URL=        # 缺省回退到 VITE_AI_BASE_URL
VITE_CONTEXT_LLM_TEMPERATURE=0.3
VITE_CONTEXT_LLM_MAX_TOKENS=512
